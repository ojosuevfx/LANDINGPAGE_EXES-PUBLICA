          </svg>
          <p style="font-size: 13px; line-height: 1.6; color: #B2B3B4; max-width: 34ch; margin: 18px 0 16px;">Gestora de fundos de investimentos de crédito privado. Fale com a Éxes pelos nossos canais:</p>
          <div style="display: flex; gap: 8px;">
            <a href="#" aria-label="LinkedIn" style="display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 999px; border: 1px solid rgba(255,255,255,0.24); color: #ffffff;" style-hover="background: rgba(255,255,255,0.10);">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-4 0v7h-4v-13h4v1.5A6 6 0 0116 8z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
            </a>
            <a href="#" aria-label="Instagram" style="display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 999px; border: 1px solid rgba(255,255,255,0.24); color: #ffffff;" style-hover="background: rgba(255,255,255,0.10);">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><line x1="17.5" y1="6.5" x2="17.5" y2="6.5"></line></svg>
            </a>
            <a href="#" aria-label="Site" style="display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 999px; border: 1px solid rgba(255,255,255,0.24); color: #ffffff;" style-hover="background: rgba(255,255,255,0.10);">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15 15 0 010 20 15 15 0 010-20z"></path></svg>
            </a>
          </div>
        </div>
        <div style="min-width: 0;">
          <h4 style="font-size: 13px; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: var(--exes-accent, #4AA6B3); margin: 0 0 16px;">A gestora</h4>
          <div style="display: grid; gap: 10px;">
            <a href="#gestora" style="font-size: 13.5px; color: #B2B3B4; text-decoration: none;" style-hover="color: #ffffff;">Sobre a Éxes</a>
            <a href="#" style="font-size: 13.5px; color: #B2B3B4; text-decoration: none;" style-hover="color: #ffffff;">Fundos sob gestão</a>
            <a href="#" style="font-size: 13.5px; color: #B2B3B4; text-decoration: none;" style-hover="color: #ffffff;">Contato</a>
          </div>
        </div>
        <div style="min-width: 0;">
          <h4 style="font-size: 13px; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: var(--exes-accent, #4AA6B3); margin: 0 0 16px;">Transparência</h4>
          <div style="display: grid; gap: 10px;">
            <a href="#documentos" style="font-size: 13.5px; color: #B2B3B4; text-decoration: none;" style-hover="color: #ffffff;">Prospecto e Lâmina</a>
            <a href="#documentos" style="font-size: 13.5px; color: #B2B3B4; text-decoration: none;" style-hover="color: #ffffff;">Regulamento</a>
            <a href="#" style="font-size: 13.5px; color: #B2B3B4; text-decoration: none;" style-hover="color: #ffffff;">Fatos relevantes</a>
          </div>
        </div>
        <div style="min-width: 0;">
          <h4 style="font-size: 13px; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: var(--exes-accent, #4AA6B3); margin: 0 0 16px;">Recursos</h4>
          <div style="display: grid; gap: 10px;">
            <a href="#" style="font-size: 13.5px; color: #B2B3B4; text-decoration: none;" style-hover="color: #ffffff;">Relatórios gerenciais</a>
            <a href="#faq" style="font-size: 13.5px; color: #B2B3B4; text-decoration: none;" style-hover="color: #ffffff;">Perguntas frequentes</a>
            <a href="#" style="font-size: 13.5px; color: #B2B3B4; text-decoration: none;" style-hover="color: #ffffff;">Fundos.NET</a>
          </div>
        </div>
      </div>

      <div style="border-top: 1px solid rgba(255,255,255,0.14); margin-top: 32px; padding-top: 26px; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; align-items: center;">
        <p style="font-size: 14px; font-weight: 700; line-height: 1.55; color: #ffffff; margin: 0; max-width: 48ch;">Receba os relatórios e comunicados do EXES11 por e-mail, com as atualizações da oferta.</p>
        <div style="display: flex; flex-wrap: wrap; gap: 10px;">
          <input type="email" placeholder="Seu e-mail" style="flex: 1 1 190px; min-width: 0; font-family: Archivo, system-ui, sans-serif; font-size: 14px; color: #ffffff; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.22); border-radius: 999px; padding: 14px 18px;">
          <button type="button" style="font-family: Archivo, system-ui, sans-serif; font-size: 14px; font-weight: 800; color: #10222f; background: var(--exes-accent, #4AA6B3); border: 0; border-radius: 999px; padding: 14px 22px; cursor: pointer;" style-hover="background: #3d8f9b;">Quero receber</button>
        </div>
      </div>

      <div style="border-top: 1px solid rgba(255,255,255,0.14); margin-top: 26px; padding-top: 20px; display: flex; flex-wrap: wrap; gap: 12px; justify-content: space-between;">
        <span style="font-size: 11px; color: #787D81;">© 2026 Éxes Gestora de Recursos Ltda. Todos os direitos reservados.</span>
        <span style="font-size: 11px; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: #787D81;">Material publicitário</span>
      </div>
    </div>
  </footer>
</div>
</x-dc>
<script type="text/x-dc" data-dc-script data-props="{&quot;accent&quot;:{&quot;editor&quot;:&quot;color&quot;,&quot;default&quot;:&quot;#4AA6B3&quot;,&quot;tsType&quot;:&quot;string&quot;,&quot;options&quot;:[&quot;#4AA6B3&quot;,&quot;#374D61&quot;,&quot;#1D2F41&quot;],&quot;section&quot;:&quot;Marca&quot;},&quot;ctaLabel&quot;:{&quot;editor&quot;:&quot;text&quot;,&quot;default&quot;:&quot;Quero investir no EXES11&quot;,&quot;tsType&quot;:&quot;string&quot;,&quot;section&quot;:&quot;Conteúdo&quot;}}">
class Component extends DCLogic {
  state = { scenario: "base", open: { 1: true, 2: false, 3: false, 4: false }, gx: 50, gy: 50, gHover: false };

  tab(active) {
    return "flex: 1; font-family: Archivo, system-ui, sans-serif; font-size: 13.5px; font-weight: 800; border: 0; border-radius: 999px; padding: 12px 14px; cursor: pointer; transition: background 140ms ease;" +
      (active
        ? " background: #1D2F41; color: #ffffff;"
        : " background: transparent; color: #585858;");
  }

  toggle(n) {
    return () => this.setState(s => ({ open: Object.assign({}, s.open, { [n]: !s.open[n] }) }));
  }

  renderVals() {
    const base = this.state.scenario === "base";
    return {
      accent: this.props.accent ?? "#4AA6B3",
      onGlassMove: (e) => {
        const r = e.currentTarget.getBoundingClientRect();
        this.setState({
          gx: ((e.clientX - r.left) / r.width) * 100,
          gy: ((e.clientY - r.top) / r.height) * 100,
          gHover: true
        });
      },
      onGlassLeave: () => this.setState({ gHover: false, gx: 50, gy: 50 }),
      menuOpen: !!this.state.menuOpen,
      toggleMenu: () => this.setState(s => ({ menuOpen: !s.menuOpen })),
      closeMenu: () => this.setState({ menuOpen: false }),
      glassSheen: "position: absolute; inset: 0; border-radius: 999px; pointer-events: none; z-index: 2;" +
        " opacity: " + (this.state.gHover ? 1 : 0) + ";" +
        " transition: opacity 300ms ease, background 120ms linear;" +
        " background: radial-gradient(200px circle at " + this.state.gx.toFixed(1) + "% " + this.state.gy.toFixed(1) +
        "%, rgba(255,255,255,0.55), rgba(74,166,179,0.16) 45%, rgba(255,255,255,0) 70%);",
      ctaLabel: this.props.ctaLabel ?? "Quero investir no EXES11",
      pickBase: () => this.setState({ scenario: "base" }),
      pickCons: () => this.setState({ scenario: "cons" }),
      baseTabStyle: this.tab(base),
      consTabStyle: this.tab(!base),
      scenarioNote: base
        ? "Cenário base: considera a carteira atual, sem depender de captação de recursos novos."
        : "Cenário conservador: considera inadimplência de 3,22% da carteira e execução de garantias.",
      metricALabel: base ? "TIR projetada — 5 anos" : "Retorno total projetado",
      metricAValue: base ? "14,74% a.a." : "14,55% a.a.",
      metricANote: base ? "Equivalente a CDI + 3,40%." : "Equivalente a CDI + 3,23%.",
      metricBLabel: base ? "Dividend yield — 1º ano" : "Impacto na distribuição",
      metricBValue: base ? "15,81%" : "R$ 0,01",
      metricBNote: base
        ? "Ou 18,60% se comparado a uma aplicação tributada."
        : "É a queda por cota na distribuição do primeiro ano, mesmo com as perdas simuladas.",
      open1: !!this.state.open[1],
      open2: !!this.state.open[2],
      open3: !!this.state.open[3],
      open4: !!this.state.open[4],
      t1: this.toggle(1),
      t2: this.toggle(2),
      t3: this.toggle(3),
      t4: this.toggle(4)
    };
  }
}
</script>
</body>
</html>
