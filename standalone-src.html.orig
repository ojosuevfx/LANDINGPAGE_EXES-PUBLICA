  <section id="numeros" data-screen-label="04 Carteira" style="padding: clamp(48px, 6vw, 90px) clamp(16px, 4vw, 40px) 0;">
    <div style="max-width: 1240px; margin: 0 auto;">
      <div style="max-width: 60ch; margin-bottom: clamp(28px, 3vw, 44px);">
        <span style="display: inline-block; font-size: 11.5px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: #1D2F41; background: rgba(74,166,179,0.22); border: 1px solid rgba(74,166,179,0.45); border-radius: 999px; padding: 7px 14px; margin-bottom: 18px;">A carteira em números</span>
        <h2 style="font-size: clamp(28px, 3.2vw, 44px); line-height: 1.07; letter-spacing: -0.03em; font-weight: 900; margin: 0 0 14px;">Concentração baixa e cobertura de garantias</h2>
        <p style="font-size: 16px; line-height: 1.65; color: #374D61; margin: 0;">A carteira é pulverizada em 19 operações, com exposição máxima controlada e diversificação entre setores.</p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 16px; margin-bottom: 16px;">
        <div style="background: #ffffff; border: 1px solid rgba(29,47,65,0.10); border-radius: 22px; padding: 24px;">
          <div style="font-size: clamp(26px, 2.6vw, 34px); font-weight: 900; letter-spacing: -0.03em; line-height: 1;">19</div>
          <p style="font-size: 13px; color: #585858; margin: 8px 0 0;">operações na carteira</p>
        </div>
        <div style="background: #ffffff; border: 1px solid rgba(29,47,65,0.10); border-radius: 22px; padding: 24px;">
          <div style="font-size: clamp(26px, 2.6vw, 34px); font-weight: 900; letter-spacing: -0.03em; line-height: 1;">R$ 136,5 mi</div>
          <p style="font-size: 13px; color: #585858; margin: 8px 0 0;">de patrimônio líquido</p>
        </div>
        <div style="background: #ffffff; border: 1px solid rgba(29,47,65,0.10); border-radius: 22px; padding: 24px;">
          <div style="font-size: clamp(26px, 2.6vw, 34px); font-weight: 900; letter-spacing: -0.03em; line-height: 1;">7,15%</div>
          <p style="font-size: 13px; color: #585858; margin: 8px 0 0;">maior exposição de crédito em relação ao patrimônio</p>
        </div>
        <div style="background: #ffffff; border: 1px solid rgba(29,47,65,0.10); border-radius: 22px; padding: 24px;">
          <div style="font-size: clamp(26px, 2.6vw, 34px); font-weight: 900; letter-spacing: -0.03em; line-height: 1; color: var(--exes-accent, #4AA6B3);">52%</div>
          <p style="font-size: 13px; color: #585858; margin: 8px 0 0;">LTV médio ponderado com garantia real</p>
        </div>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px;">
        <div style="background: rgba(74,166,179,0.10); border: 2px dashed rgba(74,166,179,0.6); border-radius: 24px; padding: 28px; min-height: 210px; display: flex; flex-direction: column; justify-content: center; gap: 8px; min-width: 0;">
          <span style="font-size: 11px; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: #2f7f8a;">Gráfico a inserir</span>
          <p style="font-size: 15px; line-height: 1.5; color: #374D61; margin: 0;">Concentração por operação (% do PL) e LTV por operação (%) — slide “Concentração e cobertura de garantias”.</p>
        </div>
        <div style="background: #ffffff; border: 1px solid rgba(29,47,65,0.10); border-radius: 24px; padding: 28px; min-width: 0;">
          <h3 style="font-size: 17px; font-weight: 800; margin: 0 0 16px;">Diversificação setorial</h3>
          <div style="display: flex; flex-wrap: wrap; gap: 8px;">
            <span style="font-size: 13px; font-weight: 600; color: #1D2F41; background: #F3F2F2; border-radius: 999px; padding: 9px 15px;">Incorporação residencial</span>
            <span style="font-size: 13px; font-weight: 600; color: #1D2F41; background: #F3F2F2; border-radius: 999px; padding: 9px 15px;">Educacional</span>
            <span style="font-size: 13px; font-weight: 600; color: #1D2F41; background: #F3F2F2; border-radius: 999px; padding: 9px 15px;">Varejo essencial</span>
            <span style="font-size: 13px; font-weight: 600; color: #1D2F41; background: #F3F2F2; border-radius: 999px; padding: 9px 15px;">Lajes comerciais</span>
            <span style="font-size: 13px; font-weight: 600; color: #1D2F41; background: #F3F2F2; border-radius: 999px; padding: 9px 15px;">Energia</span>
            <span style="font-size: 13px; font-weight: 600; color: #585858; border: 1px solid rgba(29,47,65,0.16); border-radius: 999px; padding: 9px 15px;">entre outros</span>
          </div>
          <p style="font-size: 11px; line-height: 1.6; color: #787D81; margin: 20px 0 0;">Fonte: Éxes Gestora de Recursos — “O EXES11 em números” e “Diversificação setorial”, data-base 31/07/2026.</p>
        </div>
      </div>
    </div>
  </section>

  <section data-screen-label="05 Carteira detida" style="padding: clamp(48px, 6vw, 90px) clamp(16px, 4vw, 40px) 0;">
    <div style="max-width: 1240px; margin: 0 auto; background: #ffffff; border: 1px solid rgba(29,47,65,0.10); border-radius: 28px; padding: clamp(26px, 4vw, 44px); box-shadow: 0 8px 24px rgba(29,47,65,0.06);">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: clamp(24px, 3vw, 40px); align-items: center;">
