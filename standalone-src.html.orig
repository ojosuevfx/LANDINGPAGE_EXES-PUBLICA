              <div style="background: transparent; height: 72px; width: 176px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; box-sizing: border-box; filter: grayscale(1) contrast(1.04) brightness(0.48); opacity: 0.92;">
                <img src="assets/logo-cyrela.png" alt="" style="max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain;">
